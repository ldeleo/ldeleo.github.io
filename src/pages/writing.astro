---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/primitives/Section.astro";
import Ideas from "@/components/home/Ideas.astro";
import { PAGE_DESCRIPTIONS, PAGE_TITLES } from "@/lib/constants";
---

<SiteLayout title={PAGE_TITLES.writing} description={PAGE_DESCRIPTIONS.writing} path="/writing">
  <Section id="book" compact>
    <p class="room-kicker">Book</p>
    <h1 class="text-d2 mt-6" style="color: var(--color-ink);">The AI-Native Company</h1>
    <p class="lede mt-4">Coming soon.</p>
    <p class="topic-entry mt-6">
      <a href="/ai-native/definition">Read the first topic: Definition</a>
    </p>
  </Section>
  <Ideas />
</SiteLayout>
