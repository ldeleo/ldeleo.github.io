---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Talks from "@/components/home/Talks.astro";
import Praise from "@/components/home/Praise.astro";
import Stages from "@/components/home/Stages.astro";
import Reel from "@/components/home/Reel.astro";
import Booking from "@/components/home/Booking.astro";
import { PAGE_DESCRIPTIONS, PAGE_TITLES } from "@/lib/constants";
---

<SiteLayout
  title={PAGE_TITLES.speaking}
  description={PAGE_DESCRIPTIONS.speaking}
  path="/speaking"
>
  <Talks level="h1" />
  <Praise />
  <Stages />
  <Reel />
  <Booking />
</SiteLayout>
