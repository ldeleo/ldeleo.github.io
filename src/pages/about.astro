---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Section from "@/components/primitives/Section.astro";
import Eyebrow from "@/components/primitives/Eyebrow.astro";
import PortraitFrame from "@/components/brand/PortraitFrame.astro";
import CtaPrimary from "@/components/primitives/CtaPrimary.astro";
import Rule from "@/components/primitives/Rule.astro";
import { CTA_FULL, CTA_HREF, ENYA_URL, PAGE_DESCRIPTIONS, PAGE_TITLES } from "@/lib/constants";

const chapters = [
  {
    title: "Mathematics",
    body: "He taught in the math faculty at Universidad Complutense de Madrid from 2003 to 2007, alongside the doctorate. The habit from those years is the one he still trusts: reduce a problem to what it actually is before touching it.",
  },
  {
    title: "Deep tech",
    body: "At ARQUIMEA, an aerospace spin-off of Universidad Carlos III, he led technology-transfer programs across space, robotics, defense, and health. It was the first job turning research into products, and he was responsible for securing the funding to do it.",
  },
  {
    title: "Company building",
    body: "At Rokk3r those years were innovation projects across the US and Latin America, a portfolio of co-founded startups, and 10xU, the education platform for founders and executives.",
  },
  {
    title: "Emerging tech",
    body: "Through the blockchain years he collaborated with the Algorand and Moonbeam foundations and was a partner at Rayo Capital. That stretch taught him to tell a real technology shift from a loud one, a distinction he uses daily now.",
  },
  {
    title: "Now",
    body: "He mentors at Techstars and the Founder Institute. Based in Miami.",
  },
];
---

<SiteLayout
  title={PAGE_TITLES.about}
  description={PAGE_DESCRIPTIONS.about}
  path="/about"
>
  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-20">
      <div>
        <PortraitFrame
          src="/images/portrait.jpg"
          alt="Lorenzo de Leo"
          class="lg:sticky lg:top-28"
        />
      </div>
      <div>
        <div data-reveal>
          <Eyebrow>About</Eyebrow>
          <h1 class="text-d2 mt-6" style="color: var(--color-ink);">
            Lorenzo de Leo
          </h1>
        </div>
        <p class="lede mt-8" data-reveal style="--reveal-i: 1;">
          Lorenzo de Leo is Managing Director of
          <a href={ENYA_URL} target="_blank" rel="noopener noreferrer" class="enya-mark">ENYA Ventures</a>,
          a Miami-based pre-seed fund that backs AI‑native founders across Spanish-speaking Latin America.
          He started in pure mathematics, with a PhD from Universidad Complutense de Madrid, then spent a decade at Rokk3r, the Miami venture builder, where he created 10xU, its education platform for founders.
          He is building ENYA to run on AI agents: research, meeting prep, and relationship memory already do.
          He speaks in English, Spanish, and Italian.
        </p>

        <div class="path-list mt-14">
          {
            chapters.map((chapter, i) => (
              <article class="path" data-reveal style={`--reveal-i: ${i % 3};`}>
                <Rule class="mb-5" />
                <h2>{chapter.title}</h2>
                <p class="mt-3 text-lg leading-relaxed" style="color: var(--color-muted-strong);">
                  {chapter.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <Section style="background: var(--color-ink); color: var(--color-paper);">
    <div class="max-w-3xl">
      <div data-reveal>
        <Eyebrow inverted>Speaking</Eyebrow>
      </div>
      <h2 class="text-d2 mt-6" style="color: var(--color-paper);" data-reveal-lines>
        The talks carry the same thesis.
      </h2>
      <div class="mt-10" data-reveal style="--reveal-i: 2;">
        <CtaPrimary href={CTA_HREF} inverted>{CTA_FULL}</CtaPrimary>
      </div>
    </div>
  </Section>
</SiteLayout>
