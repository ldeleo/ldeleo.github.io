---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Hero from "@/components/home/Hero.astro";
import Thesis from "@/components/home/Thesis.astro";
import Invite from "@/components/home/Invite.astro";
import { PAGE_DESCRIPTIONS, PAGE_TITLES } from "@/lib/constants";
---

<SiteLayout title={PAGE_TITLES.home} description={PAGE_DESCRIPTIONS.home} path="/">
  <Hero />
  <Thesis />
  <figure class="room-bleed">
    <img
      src="/images/room/workshop.jpg"
      alt="Lorenzo de Leo speaking to a seated room."
      width="1600"
      height="1066"
      loading="lazy"
      decoding="async"
    />
  </figure>
  <Invite />
</SiteLayout>
