---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { BOOK_HREF, BOOK_TITLE, BOOK_TOPICS, SPINE } from "@/data/book";
import { diagramHtml } from "@/lib/diagrams.mjs";
import { SITE_URL } from "@/lib/constants";
import { canonicalUrl } from "@/lib/meta";

const path = BOOK_HREF;
const title = `${BOOK_TITLE} — Lorenzo de Leo`;
const description =
  "The AI-Native Company, written in public. People and agents as one system, and the advantage to whoever builds that system first. Six topics. Definition is the chapter that's up.";
const canonical = canonicalUrl(path);
const previewBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const shareUrl = `${SITE_URL}${previewBase}${path}`;
const shareText = `${BOOK_TITLE} — Lorenzo de Leo`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: BOOK_TITLE,
  author: { "@type": "Person", name: "Lorenzo de Leo" },
  inLanguage: "en",
  url: canonical,
  description,
};
---

<SiteLayout title={title} description={description} path={path} author="Lorenzo de Leo" jsonLd={jsonLd} reading>
  <div class="topic-shell book-landing">
    <div class="topic-layout">
      <article>
        <p class="topic-kicker">
          <span>Book · written in public</span>
        </p>
        <div class="topic-prose">
          <h1>{BOOK_TITLE}</h1>
          <p>
            This is a book about how a company is built once people and agents can work as one system. It is not a
            catalog of tools, and it is not a verdict on who has "added AI." The interesting question is the
            construction: shared memory, loops that close, and the points where a person still decides.
          </p>
          <p class="spine-callout" id="spine">{SPINE}</p>
          <Fragment set:html={diagramHtml("system")} />
          <p>
            That sentence is the spine. Every topic hangs off it. The book is written in public, which means a view
            can change. When it does, the change is recorded on the page, with a date, the way a definition gets a
            version rather than a silent edit.
          </p>
          <p>
            Six topics. Definition is the one you can read now. The others are coming, and the book grows in public
            as they do.
          </p>
          <ol class="book-topics">
            {
              BOOK_TOPICS.map((topic, index) => (
                <li class:list={["book-topic", !topic.href && "is-soon"]}>
                  <p class="book-topic-kicker">
                    {String(index + 1).padStart(2, "0")}
                    {!topic.href && (
                      <span class="soon" title="Coming soon">
                        Coming soon
                      </span>
                    )}
                  </p>
                  {topic.href ? (
                    <a class="book-topic-title" href={topic.href}>
                      {topic.title}
                    </a>
                  ) : (
                    <p class="book-topic-title" title="Coming soon">
                      {topic.title}
                    </p>
                  )}
                  <p class="book-topic-line">{topic.line}</p>
                  {topic.source && (
                    <p class="book-source">
                      Earlier writing:{" "}
                      <a href={topic.source.href} target="_blank" rel="noopener noreferrer">
                        {topic.source.title}
                        <span class="new-tab"> (opens in a new tab)</span>
                      </a>
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
          <nav class="topic-pager" aria-label="Chapters">
            <a class="pager-next" href="/ai-native/definition">
              <span class="pager-kicker">Next</span>
              Definition
            </a>
          </nav>
        </div>
      </article>
      <aside class="topic-rail" aria-label="Share">
        <div class="rail-block">
          <p class="rail-label">Share</p>
          <p class="rail-note">If you want to pass it on.</p>
          <div class="cta-actions">
            <a class="cta-btn" data-share="x" data-share-text={shareText} href={`https://x.com/intent/post?text=${encodeURIComponent(`${shareText} ${shareUrl} @LorenzodeLeo_`)}`} target="_blank" rel="noopener noreferrer">Post on X<span class="new-tab"> (opens in a new tab)</span></a>
            <a class="cta-btn" data-share="linkedin" data-share-text={shareText} href={`https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(`${shareText} ${shareUrl} @LorenzodeLeo_`)}`} target="_blank" rel="noopener noreferrer">Post on LinkedIn<span class="new-tab"> (opens in a new tab)</span></a>
            <button class="cta-btn" type="button" data-copy>Copy link</button>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <script is:inline>
    const payloadFor = (text, url) => text + " " + url;
    const intent = (kind, text, url) => {
      const payload = encodeURIComponent(payloadFor(text, url));
      return kind === "x"
        ? "https://x.com/intent/post?text=" + payload
        : "https://www.linkedin.com/feed/?shareActive=true&text=" + payload;
    };
    const pageUrl = () => location.origin + location.pathname;
    for (const link of document.querySelectorAll("[data-share]")) {
      const text = link.getAttribute("data-share-text") || document.title;
      link.href = intent(link.getAttribute("data-share"), text, pageUrl());
    }
    const copy = document.querySelector("[data-copy]");
    if (copy) {
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pageUrl());
          copy.textContent = "Copied";
        } catch (error) {
          copy.textContent = "Copy the URL";
        }
        setTimeout(() => {
          copy.textContent = "Copy link";
        }, 1600);
      });
    }
  </script>
</SiteLayout>
