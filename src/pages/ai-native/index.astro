---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { BOOK_HREF, BOOK_TITLE, BOOK_TOPICS, SPINE } from "@/data/book";
import { diagramHtml } from "@/lib/diagrams.mjs";
import { SITE_URL } from "@/lib/constants";
import { canonicalUrl } from "@/lib/meta";

const path = BOOK_HREF;
const title = `${BOOK_TITLE} — Lorenzo de Leo`;
const description =
  "A book about how companies are built now that people and AI agents can work together as a single system. Written in public, one topic at a time.";
const canonical = canonicalUrl(path);
const previewBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const shareUrl = `${SITE_URL}${previewBase}${path}`;
const shareText = `${BOOK_TITLE} — Lorenzo de Leo`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: BOOK_TITLE,
  author: { "@type": "Person", name: "Lorenzo de Leo" },
  inLanguage: "en",
  url: canonical,
  description,
};
---

<SiteLayout title={title} description={description} path={path} author="Lorenzo de Leo" jsonLd={jsonLd} reading>
  <div class="topic-shell book-landing">
    <div class="topic-layout">
      <article>
        <p class="topic-kicker">
          <span>Book · written in public</span>
        </p>
        <div class="topic-prose">
          <h1>{BOOK_TITLE}</h1>
          <p>
            This is a book about how companies are built now that people and AI agents can work together as a single
            system.
          </p>
          <p>
            Much of what gets written about AI in business is about tools: which ones to buy, which tasks they take
            over, and which companies have "added AI" and which haven't. That work is useful, and I draw on a lot of
            it, but it is not what this book is about. The question I care about is how a company is put together.
            Where does its memory live, so that people and agents work from the same knowledge? How does the work move
            in loops that close quickly, so that what the company learns this week changes what it does next week? And
            where, inside all of that, does a person still make the call?
          </p>
          <p>Everything in the book starts from one sentence:</p>
          <p class="spine-callout" id="spine">{SPINE}</p>
          <Fragment set:html={diagramHtml("system")} />
          <p>
            The diagram is that sentence drawn out. On one side are the people and on the other the agents, and
            between them sits a single memory that both can read and write. The work moves around the loop: something
            happens, the company learns from it, and what it learns changes the next round of work. The marked points
            are the moments where a person, not a model, makes the decision. Each topic in this book takes one part of
            this picture and looks at it closely, and the Definition topic explains the full working definition behind
            it.
          </p>
          <h2>Written in public</h2>
          <p>
            This book is being written in public, one topic at a time, and that has a consequence worth stating at the
            start: some of my views will change as I learn. When one does, I won't quietly rewrite the page. Each topic
            carries a version number and a changelog, and every change is recorded there with its date, so you can see
            what I thought before and why I changed my mind.
          </p>
          <p>
            It is the same habit that helped settle an earlier argument. "Cloud-native" also meant whatever a vendor
            needed it to mean, until a community wrote a definition down and kept maintaining it in the open. This book
            is one person keeping a set of pages rather than a foundation, but the practice is the same.
          </p>
          <h2>The six topics</h2>
          <p>
            The book is organized in six topics. The first, Definition, is ready to read now. It looks at what
            different people mean by "AI-native", sets out the definition this book uses, and offers seven questions
            for judging how far along a company really is. The other five are in progress, and each one will appear
            here when it is published. Where I have written about a topic before, you'll find a link to that earlier
            piece under it.
          </p>
          <ol class="book-topics">
            {
              BOOK_TOPICS.map((topic, index) => (
                <li class:list={["book-topic", !topic.href && "is-soon"]}>
                  <p class="book-topic-kicker">
                    {String(index + 1).padStart(2, "0")}
                    {!topic.href && (
                      <span class="soon" title="Coming soon">
                        Coming soon
                      </span>
                    )}
                  </p>
                  {topic.href ? (
                    <a class="book-topic-title" href={topic.href}>
                      {topic.title}
                    </a>
                  ) : (
                    <p class="book-topic-title" title="Coming soon">
                      {topic.title}
                    </p>
                  )}
                  <p class="book-topic-line">{topic.line}</p>
                  {topic.source && (
                    <p class="book-source">
                      Earlier writing:{" "}
                      <a href={topic.source.href} target="_blank" rel="noopener noreferrer">
                        {topic.source.title}
                        <span class="new-tab"> (opens in a new tab)</span>
                      </a>
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
          <nav class="topic-pager" aria-label="Chapters">
            <a class="pager-next" href="/ai-native/definition">
              <span class="pager-kicker">Next</span>
              Definition
            </a>
          </nav>
        </div>
      </article>
      <aside class="topic-rail" aria-label="Share">
        <div class="rail-block">
          <p class="rail-label">Share</p>
          <p class="rail-note">If you want to pass it on.</p>
          <div class="cta-actions">
            <a class="cta-btn" data-share="x" data-share-text={shareText} href={`https://x.com/intent/post?text=${encodeURIComponent(`${shareText} ${shareUrl} @LorenzodeLeo_`)}`} target="_blank" rel="noopener noreferrer">Post on X<span class="new-tab"> (opens in a new tab)</span></a>
            <a class="cta-btn" data-share="linkedin" data-share-text={shareText} href={`https://www.linkedin.com/feed/?shareActive=true&text=${encodeURIComponent(`${shareText} ${shareUrl} @LorenzodeLeo_`)}`} target="_blank" rel="noopener noreferrer">Post on LinkedIn<span class="new-tab"> (opens in a new tab)</span></a>
            <button class="cta-btn" type="button" data-copy>Copy link</button>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <script is:inline>
    const payloadFor = (text, url) => text + " " + url;
    const intent = (kind, text, url) => {
      const payload = encodeURIComponent(payloadFor(text, url));
      return kind === "x"
        ? "https://x.com/intent/post?text=" + payload
        : "https://www.linkedin.com/feed/?shareActive=true&text=" + payload;
    };
    const pageUrl = () => location.origin + location.pathname;
    for (const link of document.querySelectorAll("[data-share]")) {
      const text = link.getAttribute("data-share-text") || document.title;
      link.href = intent(link.getAttribute("data-share"), text, pageUrl());
    }
    const copy = document.querySelector("[data-copy]");
    if (copy) {
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pageUrl());
          copy.textContent = "Copied";
        } catch (error) {
          copy.textContent = "Copy the URL";
        }
        setTimeout(() => {
          copy.textContent = "Copy link";
        }, 1600);
      });
    }
  </script>
</SiteLayout>
