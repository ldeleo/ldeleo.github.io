---
import "@/styles/global.css";
import SiteHeader from "@/components/nav/SiteHeader.astro";
import SiteFooter from "@/components/nav/SiteFooter.astro";
import { canonicalUrl, ogImageUrl } from "@/lib/meta";
import { BRAND_NAME_FULL } from "@/lib/constants";

type Props = {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** BCP-47 code for pages not written in English (e.g. the EspacioTec resources). */
  lang?: string;
};

const { title, description, path, ogImage, lang = "en" } = Astro.props;
const canonical = canonicalUrl(path);
const image = ogImage ?? ogImageUrl();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {
      import.meta.env.BASE_URL.startsWith("/preview") && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={BRAND_NAME_FULL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>

    <meta name="theme-color" content="#0C0B0A" />
  </head>
  <body class="min-h-screen">
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Reveal-on-scroll: reveal each [data-reveal] once, when it enters view.
      // Elements already in the first viewport reveal on load (with their
      // stagger). Respects reduced-motion by showing everything immediately.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        reveals.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
