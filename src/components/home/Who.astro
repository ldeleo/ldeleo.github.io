---
import Section from "@/components/primitives/Section.astro";
import Eyebrow from "@/components/primitives/Eyebrow.astro";
import CtaSecondary from "@/components/primitives/CtaSecondary.astro";
import { ENYA_URL } from "@/lib/constants";
---

<Section id="who" compact>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)] lg:gap-16">
    <div data-reveal>
      <Eyebrow>Who I am</Eyebrow>
    </div>
    <div data-reveal style="--reveal-i: 1;">
      <p class="measure-wide font-serif text-2xl leading-snug md:text-[1.85rem]" style="color: var(--color-ink); font-weight: 480; letter-spacing: -0.02em;">
        I'm Lorenzo de Leo, Managing Director of
        <a href={ENYA_URL} target="_blank" rel="noopener noreferrer" class="enya-mark">ENYA Ventures</a>,
        a Miami pre-seed fund that backs AI‑native founders in Latin America.
      </p>
      <p class="measure mt-6 text-lg leading-relaxed" style="color: var(--color-muted-strong);">
        I invest in this thesis, and I'm building the fund to run on it.
        Research, meeting prep, and relationship memory already do.
      </p>
      <CtaSecondary href={ENYA_URL} external class="mt-6 text-base">
        enya.vc
      </CtaSecondary>
    </div>
  </div>
</Section>
