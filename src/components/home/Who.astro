---
import Section from "@/components/primitives/Section.astro";
import { ENYA_URL } from "@/lib/constants";
---

<Section id="who" class="room-who" compact>
  <div class="room-who__copy" data-reveal>
    <p class="room-who__lead">
      I'm Lorenzo de Leo. ENYA Ventures is the AI-native fund I'm building for Latin America.
    </p>
    <p>
      Research, meeting prep, and relationship memory already run on it.
      <a href={ENYA_URL} class="enya-mark" target="_blank" rel="noopener noreferrer">enya.vc</a>
    </p>
  </div>
</Section>
