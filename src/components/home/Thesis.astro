---
import Section from "@/components/primitives/Section.astro";
import Eyebrow from "@/components/primitives/Eyebrow.astro";
import { BELIEFS } from "@/data/content";

type Props = {
  level?: "h1" | "h2";
};

const { level = "h2" } = Astro.props;
const Title = level;
---

<Section
  id="thesis"
  style="background: color-mix(in srgb, var(--color-paper-deep) 65%, var(--color-paper));"
>
  <div class="max-w-3xl" data-reveal>
    <Eyebrow>The thesis</Eyebrow>
    <Title class="text-d2 mt-6" style="color: var(--color-ink);">
      Four beliefs about being AI‑native.
    </Title>
  </div>

  <ol class="belief-list">
    {
      BELIEFS.map((belief, i) => (
        <li class="belief" data-reveal style={`--reveal-i: ${i % 2};`}>
          <span class="belief-index">{belief.index}</span>
          <div>
            <h3>{belief.title}</h3>
            <p class="mt-4">{belief.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
