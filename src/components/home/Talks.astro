---
import Section from "@/components/primitives/Section.astro";
import Eyebrow from "@/components/primitives/Eyebrow.astro";
import { TALKS } from "@/data/content";
import { publicUrl } from "@/lib/public-url";

type Props = {
  /** h1 when this section opens a page; h2 on the home page. */
  level?: "h1" | "h2";
};

const { level = "h2" } = Astro.props;
const Title = level;
const TalkTitle = level === "h1" ? "h2" : "h3";
---

<Section id="talks" class="room-talks">
  <div class="room-split">
    <div data-reveal>
    <Eyebrow>Talks</Eyebrow>
    <Title class="text-d2 mt-6" style="color: var(--color-ink);">
      One idea, three formats.
    </Title>
    <p class="lede measure mt-6">
      Talks and keynotes, in person or virtual. Workshops in person.
    </p>
    <p class="lede measure mt-4">
      For leadership teams, family businesses, founders, and investors. English, Spanish, or Italian.
    </p>
    </div>
    <picture>
      <source srcset={publicUrl("/images/room/cut-stage.avif")} type="image/avif" />
      <source srcset={publicUrl("/images/room/cut-stage.webp")} type="image/webp" />
      <img
        class="room-split__cut"
        src={publicUrl("/images/room/cut-stage.webp")}
        alt="Lorenzo de Leo speaking into a microphone, close up."
        width="900"
        height="574"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>

  <div class="talk-list">
    {
      TALKS.map((talk, i) => (
        <article class="talk" id={talk.id} data-reveal style={`--reveal-i: ${i % 2};`}>
          <div class="talk-main">
            <p class="talk-kicker">
              <span class="talk-index">{talk.index}</span>
              <span class="talk-format">{talk.format}</span>
            </p>
            <TalkTitle>{talk.title}</TalkTitle>
            <p class="talk-for">For {talk.audience}.</p>
            <p class="talk-idea">{talk.idea}</p>
          </div>
          <div class="talk-leaves">
            <p class="talk-leaves-label">The room leaves with</p>
            <ul class="takeaways">
              {talk.takeaways.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</Section>
