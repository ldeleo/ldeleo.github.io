---
import Section from "@/components/primitives/Section.astro";
import Eyebrow from "@/components/primitives/Eyebrow.astro";
import {
  ENYA_URL,
  LINKEDIN_URL,
  SPEAKING_EMAIL,
  SUBSTACK_URL,
  WEB3FORMS_ACCESS_KEY,
  X_URL,
} from "@/lib/constants";

type Props = {
  level?: "h1" | "h2";
};

const { level = "h2" } = Astro.props;
const Title = level;

const mailto = `mailto:${SPEAKING_EMAIL}?subject=${encodeURIComponent("Speaking inquiry")}&body=${encodeURIComponent("Date:\nAudience:\nOutcome I want the room to leave with:\n")}`;
---

<Section id="invite">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-20">
    <div>
      <div data-reveal>
        <Eyebrow>Get in touch</Eyebrow>
      </div>
      <Title class="text-d2 mt-6" style="color: var(--color-ink);">
        Invite Lorenzo to speak.
      </Title>
      <p class="mt-6 max-w-md text-lg leading-relaxed" style="color: var(--color-muted-strong);" data-reveal style="--reveal-i: 2;">
        Tell me the date, the audience, and the outcome you want the room to leave with. I'll tell you which session fits.
      </p>
      <p class="booking-mail mt-8 text-base leading-relaxed" style="color: var(--color-muted-strong);" data-reveal style="--reveal-i: 3;">
        Or write directly:
        <a href={mailto}>{SPEAKING_EMAIL}</a>
      </p>
      <p class="mt-4 text-base" style="color: var(--color-muted-strong);" data-reveal style="--reveal-i: 3;">
        Speaker kit available on request.
      </p>
      <p class="mt-8 max-w-md text-sm leading-relaxed" style="color: var(--color-muted);" data-reveal style="--reveal-i: 4;">
        Building an AI‑native company in Spanish-speaking Latin America?
        The fund reads
        <a href={ENYA_URL} class="underline" target="_blank" rel="noopener noreferrer">enya.vc</a>.
      </p>
      <p class="contact-channels" data-reveal style="--reveal-i: 5;">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={X_URL} class="tap-44" target="_blank" rel="noopener noreferrer">X</a>
        <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Substack</a>
      </p>
    </div>

    <form
      id="booking-form"
      class="booking-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-reveal
      style="--reveal-i: 1;"
    >
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="subject" value="New message from lorenzodeleo.com" />
      <input type="hidden" name="from_name" value="lorenzodeleo.com contact form" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" />

      <div class="booking-row">
        <label class="booking-field">
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="booking-field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
      </div>

      <label class="booking-field">
        <span>Organization <em>(optional)</em></span>
        <input type="text" name="organization" autocomplete="organization" />
      </label>

      <label class="booking-field">
        <span>Event date &amp; location <em>(if speaking)</em></span>
        <input type="text" name="event" autocomplete="off" />
      </label>

      <label class="booking-field">
        <span>Message</span>
        <textarea
          name="message"
          rows="6"
          required
          placeholder="For speaking: who's the audience, and what should they leave with?"></textarea>
      </label>

      <button type="submit" class="booking-submit">Send the inquiry</button>
      <p id="booking-status" class="hidden text-base" role="status"></p>
    </form>
  </div>
</Section>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement | null;
  const status = document.getElementById("booking-status");

  if (form && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (button) button.disabled = true;
      status.classList.add("hidden");

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const ok = res.ok;
        status.textContent = ok
          ? "Sent. I'll reply directly."
          : "Something went wrong. Please email lorenzodeleo.usa@gmail.com.";
        status.setAttribute("style", ok ? "color: var(--color-ink);" : "color: #FFB4A8;");
        status.classList.remove("hidden");
        if (ok) form.reset();
      } catch {
        status.textContent = "Something went wrong. Please email lorenzodeleo.usa@gmail.com.";
        status.setAttribute("style", "color: #FFB4A8;");
        status.classList.remove("hidden");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
