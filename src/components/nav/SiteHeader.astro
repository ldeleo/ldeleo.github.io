---
import Container from "@/components/primitives/Container.astro";
import Wordmark from "@/components/brand/Wordmark.astro";
import { NAV_LINKS } from "@/lib/constants";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const raw = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentPath = (base && raw.startsWith(base) ? raw.slice(base.length) : raw) || "/";
function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath === href;
}
---

<header
  class="enya-header sticky top-0 z-30"
  data-enya-header
>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Container
    as="div"
    class="flex min-h-16 flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3 md:min-h-[4.5rem] md:flex-nowrap md:py-0"
  >
    <Wordmark variant="header" href="/" />

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      Menu
    </button>

    <nav
      id="site-nav"
      aria-label="Primary"
      class="enya-primary-nav order-3 flex w-full items-center justify-between sm:order-none sm:w-auto sm:justify-start"
      style="color: var(--color-muted-strong);"
    >
      {
        NAV_LINKS.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "whitespace-nowrap transition-colors duration-200",
              isActive(item.href)
                ? "text-[color:var(--color-electric-purple)]"
                : "hover:text-[color:var(--color-electric-purple)]",
            ]}
            style={
              isActive(item.href)
                ? "border-bottom: 2px solid var(--color-electric-purple); padding-bottom: 2px;"
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </Container>
</header>

<style>
  /* Header is transparent at the top of the page (it sits over paper anyway)
     and only earns its hairline + blur once you start scrolling — a quiet
     aliveness cue that costs nothing. */
  .enya-header {
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background var(--motion-med) var(--motion-ease-out),
      border-color var(--motion-med) var(--motion-ease-out),
      backdrop-filter var(--motion-med) var(--motion-ease-out);
  }
  .enya-header.is-scrolled {
    border-bottom-color: var(--color-rule);
    background: rgba(12, 11, 10, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* Primary nav: scale labels down on small screens so all links fit on one
     row without overflowing the viewport; restore full eyebrow sizing at sm+. */
  .enya-primary-nav {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    gap: 0.6rem;
  }
  @media (min-width: 640px) {
    .enya-primary-nav {
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      gap: 0.9rem;
    }
  }
  @media (min-width: 1100px) {
    .enya-primary-nav {
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      gap: 1.35rem;
    }
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0 0.9rem;
      border: 1px solid var(--color-rule-strong);
      background: transparent;
      color: var(--color-ink);
      font: inherit;
      font-size: 1rem;
      letter-spacing: 0.04em;
    }
    .enya-primary-nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0.5rem;
    }
    .enya-header.is-open .enya-primary-nav {
      display: flex;
    }
    .enya-primary-nav a {
      min-height: 44px;
      display: flex;
      align-items: center;
      font-size: 1.0625rem;
      letter-spacing: 0.04em;
    }
  }

</style>

<script>
  // Toggle the header's scrolled state (hairline + blur) past the very top.
  const header = document.querySelector<HTMLElement>("[data-enya-header]");
  if (header) {
    const sync = () => header.classList.toggle("is-scrolled", window.scrollY > 4);
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.getElementById("site-nav");
  if (toggle && header && nav) {
    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.textContent = open ? "Close" : "Menu";
    });
    nav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        header.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = "Menu";
      }
    });
  }
</script>
